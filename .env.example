# Copy to .env and fill in your keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Postgres (matches docker-compose defaults)
POSTGRES_USER=cfpb
POSTGRES_PASSWORD=cfpb_local_dev
POSTGRES_DB=cfpb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cfpb-agent

# Model prices, USD per 1M tokens (check claude.com/pricing and openai.com/api/pricing)
FAST_PRICE_IN=0.10
FAST_PRICE_OUT=0.50
STRONG_PRICE_IN=2.00
STRONG_PRICE_OUT=10.00
